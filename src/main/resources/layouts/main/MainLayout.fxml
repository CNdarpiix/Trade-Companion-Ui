<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="layouts.main.MainLayoutController"

            prefHeight="400.0" prefWidth="600.0">
    <left>

        <StackPane fx:id="sidebar" prefWidth="150" prefHeight="80"/>

    </left>


    <center>
        <StackPane>
            <StackPane fx:id="contentPane"/>
            <FlowPane fx:id="dialogContent" alignment="BOTTOM_RIGHT" hgap="-Infinity" vgap="-Infinity"/>

        </StackPane>
    </center>


</BorderPane>
