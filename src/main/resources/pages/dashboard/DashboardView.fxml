<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pages.dashboard.DashboardController"
            prefHeight="400.0" prefWidth="600.0">
    <center>

        <VBox alignment="CENTER" spacing="10">

            <Label text="Dashboard" >
                <styleClass>
                    <String fx:value="title-h2"/>
                    <String fx:value="text-primary"/>
                </styleClass>
            </Label>

            <FlowPane VBox.vgrow="ALWAYS" hgap="20" vgap="20"  alignment="TOP_CENTER" fx:id="cardsContainer">

            </FlowPane>



        </VBox>

    </center>

</BorderPane>
